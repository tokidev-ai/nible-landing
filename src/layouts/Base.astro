---
import '../styles/global.css';
import { FAQ } from '../lib/faq';
import { STEPS } from '../lib/steps';
import { CONTACT_EMAIL, SOCIAL_LINKS } from '../config';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const origin = new URL('/', Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
const ogAlt = 'Nible: agenda y reservas online para negocios en Bolivia';
const logo = new URL('/apple-touch-icon.png', Astro.site).href;
const orgId = `${origin}#organization`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'Nible',
      url: origin,
      logo: { '@type': 'ImageObject', url: logo, width: 180, height: 180 },
      parentOrganization: { '@type': 'Organization', name: 'Pomlab' },
      areaServed: { '@type': 'Country', name: 'Bolivia' },
      ...(SOCIAL_LINKS.length > 0 ? { sameAs: SOCIAL_LINKS } : {}),
      ...(CONTACT_EMAIL ? { contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: CONTACT_EMAIL, availableLanguage: 'es' } } : {}),
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}#website`,
      url: origin,
      name: 'Nible',
      inLanguage: 'es-BO',
      publisher: { '@id': orgId },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical.href}#webpage`,
      url: canonical.href,
      name: title,
      description,
      inLanguage: 'es-BO',
      isPartOf: { '@id': `${origin}#website` },
      about: { '@id': `${origin}#app` },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${origin}#app`,
      name: 'Nible',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web, iOS, Android',
      description,
      url: canonical.href,
      image: ogImage,
      inLanguage: 'es-BO',
      featureList: ['Agenda de citas', 'Link de reservas para clientes', 'Ficha e historial de clientes', 'Servicios con precio y duración', 'Recordatorios por WhatsApp'],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'BOB', name: 'Gratis', availability: 'https://schema.org/InStock' },
      publisher: { '@id': orgId },
    },
    {
      '@type': 'HowTo',
      name: 'Cómo empezar a recibir reservas con Nible',
      inLanguage: 'es-BO',
      totalTime: 'PT2M',
      step: STEPS.map((st, i) => ({ '@type': 'HowToStep', position: i + 1, name: st.title, text: st.text, url: `${canonical.href}#empezar` })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical.href}#faq`,
      inLanguage: 'es-BO',
      mainEntity: FAQ.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
    },
  ],
};
---
<!doctype html>
<html lang="es-BO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-BO" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="Pomlab" />
    <meta name="theme-color" content="#FFFDF5" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/comfortaa.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_BO" />
    <meta property="og:site_name" content="Nible" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
