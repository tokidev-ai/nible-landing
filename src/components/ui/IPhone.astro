---
interface Props {
  class?: string;
  shadow?: 'light' | 'dark';
}

/** Dark titanium iPhone frame. The 281×608 screen hosts 390×844 app mockups scaled by SCREEN_SCALE. */
const { class: className, shadow = 'light' } = Astro.props;
---
<div class:list={['iphone', `iphone-${shadow}`, className]}>
  <span class="btn-side" style="left:-3px;top:118px;height:30px"></span>
  <span class="btn-side" style="left:-3px;top:168px;height:54px"></span>
  <span class="btn-side" style="left:-3px;top:232px;height:54px"></span>
  <span class="btn-side r" style="right:-3px;top:190px;height:84px"></span>
  <div class="bezel">
    <div class="screen" aria-hidden="true" inert>
      <slot />
    </div>
  </div>
</div>

<style>
  .iphone{position:relative;flex:0 0 auto;width:303px;height:630px;border-radius:54px;padding:4px;background:linear-gradient(145deg,#4a4d55 0%,#1d1f24 38%,#34373e 70%,#16181c 100%)}
  .iphone-light{box-shadow:0 0 0 1px #0b0c0e,0 30px 60px rgba(19,28,71,.28),0 12px 24px rgba(19,28,71,.16),inset 0 0 0 1.5px rgba(255,255,255,.12)}
  .iphone-dark{box-shadow:0 0 0 1px #0b0c0e,0 30px 60px rgba(0,0,0,.35),inset 0 0 0 1.5px rgba(255,255,255,.12)}
  .btn-side{position:absolute;width:3px;border-radius:2px 0 0 2px;background:#2a2d33}
  .btn-side.r{border-radius:0 2px 2px 0}
  .bezel{width:100%;height:100%;border-radius:50px;padding:7px;background:#050506}
  .screen{position:relative;width:281px;height:608px;border-radius:43px;overflow:hidden;background:var(--nible-cream);pointer-events:none}
</style>
