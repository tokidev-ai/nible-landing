---
interface Props {
  active?: boolean;
  /** zoom: fades in from 1.03 (hero). slide: slides 24px from the side it comes from (Cómo empezar). */
  motion?: 'zoom' | 'slide';
}

/** One app screen stacked inside an IPhone screen; the 390×844 device is scaled to fill 281×608. */
const { active = false, motion = 'zoom' } = Astro.props;
---
<div class:list={['layer', motion, { 'is-on': active }]} data-layer>
  <div class="fit"><slot /></div>
</div>

<style>
  .layer{position:absolute;inset:0;opacity:0}
  .layer.is-on{opacity:1}
  .zoom{transform:scale(1.03);transition:opacity .5s cubic-bezier(.2,.7,.3,1),transform .5s cubic-bezier(.2,.7,.3,1)}
  .slide{transform:translateX(24px);transition:opacity .5s ease,transform .6s cubic-bezier(.2,.7,.3,1)}
  .slide.is-before{transform:translateX(-24px)}
  .layer.is-on{transform:none}
  .fit{width:390px;height:844px;transform:translate(-1px,-1px) scale(.7256);transform-origin:top left}
</style>
