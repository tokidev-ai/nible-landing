---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'accent' | 'outline';
  size?: 'sm' | 'lg';
  fullWidth?: boolean;
  class?: string;
}

/** NIBLE Button (design system), rendered as a link because every CTA on the landing navigates. */
const { href, variant = 'primary', size = 'lg', fullWidth = false, class: className } = Astro.props;
---
<a href={href} class:list={['btn', `btn-${variant}`, `btn-${size}`, { 'btn-full': fullWidth }, className]}><slot /></a>

<style>
  .btn{display:inline-flex;align-items:center;justify-content:center;font-family:var(--font-text);font-weight:var(--fw-semibold);letter-spacing:var(--tracking-tight);line-height:1;white-space:nowrap;border:1.5px solid transparent;cursor:pointer;text-decoration:none;transition:background var(--dur-fast) var(--ease-standard),transform var(--dur-fast) var(--ease-standard),box-shadow var(--dur-fast) var(--ease-standard)}
  .btn:hover{text-decoration:none}
  .btn:active{transform:scale(var(--press-scale))}
  .btn-sm{height:var(--control-h-sm);padding:0 14px;font-size:var(--fs-body-sm);gap:6px;border-radius:var(--radius-sm)}
  .btn-lg{height:var(--control-h-lg);padding:0 26px;font-size:var(--fs-body);gap:10px;border-radius:var(--radius-md)}
  .btn-full{display:flex;width:100%}
  .btn-primary{background:var(--action-primary-bg);color:var(--action-primary-fg);box-shadow:var(--shadow-blue)}
  .btn-primary:hover{background:var(--action-primary-bg-hover);color:var(--action-primary-fg)}
  .btn-secondary{background:var(--action-secondary-bg);color:var(--action-secondary-fg);box-shadow:var(--shadow-sm)}
  .btn-secondary:hover{background:var(--navy-800);color:var(--action-secondary-fg)}
  .btn-accent{background:var(--action-accent-bg);color:var(--action-accent-fg);box-shadow:var(--shadow-xs)}
  .btn-accent:hover{background:var(--lime-500);color:var(--action-accent-fg)}
  .btn-outline{background:transparent;color:var(--text-strong);border-color:var(--border-default)}
  .btn-outline:hover{background:var(--grey-50);border-color:var(--grey-400);color:var(--text-strong)}
</style>
