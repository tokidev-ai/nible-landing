---
import Icon from '../ui/Icon.astro';
import { FAQ } from '../../lib/faq';
---
<section class="faq" data-screen-label="Preguntas" aria-labelledby="faq-title">
  <h2 id="faq-title" data-reveal>Preguntas frecuentes</h2>
  <div class="list">
    {FAQ.map(([q, a], i) => (
      <details name="faq" open={i === 0} data-reveal>
        <summary>
          <h3>{q}</h3>
          <span class="chev" aria-hidden="true"><Icon name="arrow-down-01" size={20} /></span>
        </summary>
        <p>{a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq{max-width:820px;margin:0 auto;padding:clamp(56px,8vw,104px) clamp(20px,4vw,40px)}
  h2{margin:0;text-align:center;font-family:var(--font-display);font-weight:700;font-size:clamp(28px,3.6vw,40px);letter-spacing:-0.01em;color:var(--navy-900)}
  .list{display:flex;flex-direction:column;gap:10px;margin-top:36px}
  details{border-radius:20px;background:#FFFFFF;border:1px solid var(--border-subtle);transition:border-color .2s ease,box-shadow .2s ease}
  details:hover{border-color:var(--blue-300);box-shadow:var(--shadow-xs)}
  summary{display:flex;align-items:center;gap:16px;padding:20px 22px;cursor:pointer;list-style:none;border-radius:20px}
  summary::-webkit-details-marker{display:none}
  h3{flex:1;margin:0;font-family:var(--font-text);font-size:16px;font-weight:500;line-height:normal;letter-spacing:normal;color:var(--navy-900)}
  .chev{color:var(--blue-500);transition:transform .2s}
  details[open] .chev{transform:rotate(180deg)}
  p{margin:0;padding:0 22px 20px;font-size:15px;line-height:1.65;color:var(--navy-700)}
  details[open] p{animation:nible-fade .2s ease both}
</style>
