---
import Icon from '../ui/Icon.astro';

const RUBROS = [
  { name: 'Barberías', icon: 'scissor' }, { name: 'Salones de belleza', icon: 'magic-star' },
  { name: 'Uñas', icon: 'heart' }, { name: 'Consultorios', icon: 'shield-tick' },
  { name: 'Entrenadores', icon: 'flash' }, { name: 'Spa', icon: 'crown' },
  { name: 'Masajes', icon: 'heart' }, { name: 'Fisioterapia', icon: 'activity' },
  { name: 'Tatuajes', icon: 'magic-star' }, { name: 'Clases', icon: 'note' },
];
// Four copies so the strip is wider than any screen; it scrolls by half for a seamless loop.
const loop = [0, 1, 2, 3].flatMap((copy) => RUBROS.map((r) => ({ ...r, copy })));
---
<section class="rubros" data-screen-label="Rubros" aria-labelledby="rubros-title">
  <p id="rubros-title" class="title">Pensado para</p>
  <ul class="sr-only">{RUBROS.map((r) => <li>{r.name}</li>)}</ul>
  <div class="mask" aria-hidden="true">
    <div class="track">
      {loop.map((r) => (
        <span class="pill">
          <span style="color:var(--blue-500)"><Icon name={r.icon} size={20} /></span>
          {r.name}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .rubros{padding:0 0 clamp(56px,8vw,88px)}
  .title{margin:0 0 16px;text-align:center;font-size:13px;color:var(--text-muted)}
  .mask{position:relative;overflow:hidden;padding:6px 0;-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
  .track{display:flex;gap:10px;width:max-content;animation:nible-marquee 32s linear infinite}
  .track:hover{animation-play-state:paused}
  .pill{flex:0 0 auto;display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 20px;border-radius:999px;background:#FFFFFF;border:1px solid var(--border-subtle);font-size:15px;font-weight:500;color:var(--navy-900);white-space:nowrap;cursor:default;transition:border-color .2s ease,transform .2s ease,box-shadow .2s ease}
  .pill:hover{border-color:var(--blue-500);transform:translateY(-2px);box-shadow:var(--shadow-sm)}
  @media (prefers-reduced-motion: reduce){ .track{animation:none} }
</style>
