---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { APP_LOGIN_URL, APP_SIGNUP_URL } from '../../config';
---
<section id="prueba" class="signup" data-screen-label="Crear cuenta">
  <div class="box">
    <div class="pattern" aria-hidden="true" style="opacity:.07"></div>
    <div class="glow" aria-hidden="true"></div>

    <div class="float f1" aria-hidden="true">
      <span class="f1-ic"><Icon name="calendar-tick" variant="bold" size={18} /></span>
      <span>
        <span class="f-t">Nueva reserva</span>
        <span class="f-s">Diego Paz · 15:00</span>
      </span>
    </div>
    <div class="float f2" aria-hidden="true">
      <Icon name="tick-circle" variant="bold" size={20} />
      <span class="f-t">Cita confirmada · Bs 60</span>
    </div>

    <div class="content">
      <span class="tag"><Icon name="flash" variant="bold" size={14} />Plan Gratis para siempre</span>
      <h2 data-reveal>Tu próxima reserva puede llegar hoy</h2>
      <p class="lead">Crea tu cuenta, carga tus servicios y comparte tu link. Todo en menos de dos minutos.</p>
      <div class="cta">
        <Button href={APP_SIGNUP_URL} variant="accent" size="lg">Crear mi cuenta gratis</Button>
      </div>
      <p class="login">¿Ya tienes cuenta? <a href={APP_LOGIN_URL}>Ingresa a la app</a></p>
    </div>
  </div>
</section>

<style>
  .signup{padding:clamp(24px,4vw,48px) clamp(12px,2vw,24px)}
  .box{position:relative;max-width:1240px;margin:0 auto;border-radius:36px;background:var(--gradient-navy);overflow:hidden}
  .glow{position:absolute;left:50%;top:50%;width:720px;height:720px;margin:-360px 0 0 -360px;border-radius:999px;background:radial-gradient(closest-side,rgba(62,98,216,.45),transparent)}
  .float{position:absolute;display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:16px;box-shadow:var(--shadow-md)}
  .f1{left:clamp(16px,6vw,80px);top:clamp(28px,5vw,56px);background:#FFFFFF;animation:nible-float 6s ease-in-out infinite}
  .f1-ic{width:34px;height:34px;display:grid;place-items:center;border-radius:12px;background:var(--lime-300);color:var(--navy-900)}
  .f2{right:clamp(16px,6vw,80px);bottom:clamp(28px,5vw,56px);background:var(--nible-lime);color:var(--navy-900);animation:nible-float 7s ease-in-out 1.2s infinite}
  .f-t{display:block;font-size:13px;font-weight:600;color:var(--navy-900);white-space:nowrap}
  .f-s{display:block;font-size:12px;color:var(--text-muted);white-space:nowrap}
  .content{position:relative;max-width:680px;margin:0 auto;padding:clamp(120px,14vw,150px) clamp(24px,5vw,48px);text-align:center}
  .tag{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;background:rgba(255,253,245,.10);border:1px solid rgba(255,253,245,.16);color:var(--nible-lime);font-size:12px;font-weight:600;white-space:nowrap}
  h2{margin:20px 0 0;font-family:var(--font-display);font-weight:700;font-size:clamp(34px,5.4vw,60px);line-height:1.06;letter-spacing:-0.02em;color:var(--nible-cream);text-wrap:balance}
  .lead{margin:18px auto 0;max-width:480px;font-size:clamp(16px,1.6vw,18px);line-height:1.6;font-weight:300;color:var(--blue-200);text-wrap:pretty}
  .cta{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-top:32px}
  .login{margin:18px 0 0;font-size:14px;color:var(--blue-200)}
  .login a{color:var(--nible-cream);font-weight:500;text-decoration:underline;text-underline-offset:3px}
  @media (prefers-reduced-motion: reduce){ .float{animation:none} }
</style>
