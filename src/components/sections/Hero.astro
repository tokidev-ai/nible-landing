---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import IPhone from '../ui/IPhone.astro';
import PhoneLayer from '../ui/PhoneLayer.astro';
import ScreenHoy from '../app/ScreenHoy.astro';
import ScreenAgenda from '../app/ScreenAgenda.astro';
import ScreenLink from '../app/ScreenLink.astro';
import ScreenCliente from '../app/ScreenCliente.astro';

// Demo steps: label under the phone and where the simulated tap lands (390×844 app coordinates).
const DEMO = [
  { label: 'Abres la app y ves tu día', tap: [330, 300] },
  { label: 'Revisas la agenda y los cupos libres', tap: [318, 82] },
  { label: 'Agendas a mano en un toque', tap: [195, 790] },
  { label: 'Compartes tu link y te reservan solos', tap: [120, 262] },
  { label: 'Cada cliente queda guardado con su historial', tap: [46, 82] },
];
---
<section class="container hero" data-screen-label="Hero">
  <div>
    <span class="badge"><span class="flag" role="img" aria-label="Bandera de Bolivia"><span></span><span></span><span></span></span>Hecho en Bolivia</span>
    <h1 data-reveal>Tu agenda se llena <span>mientras tú atiendes</span></h1>
    <p class="lead" data-reveal>Tus clientes reservan solos desde tu link, a cualquier hora. Tú abres el celular y ya sabes quién viene, a qué hora y qué servicio.</p>
    <div class="cta" data-reveal>
      <Button href="#prueba" size="lg">Probar gratis</Button>
    </div>
    <div class="meta">
      <span>Lo configuras en menos de dos minutos</span>
      <span class="sep" aria-hidden="true"></span>
      <span>Un producto de <strong>Pomlab</strong></span>
    </div>
  </div>

  <div class="demo" data-demo data-ms="3200" data-taps={JSON.stringify(DEMO.map((d) => d.tap))}>
    <div class="stage">
      <div class="glow" aria-hidden="true"></div>
      <IPhone>
        <PhoneLayer active><ScreenHoy /></PhoneLayer>
        <PhoneLayer><ScreenAgenda /></PhoneLayer>
        <PhoneLayer><ScreenAgenda sheet /></PhoneLayer>
        <PhoneLayer><ScreenLink /></PhoneLayer>
        <PhoneLayer><ScreenCliente /></PhoneLayer>
        <span class="tap" data-tap></span>
      </IPhone>

      <div class="chip chip-notif" data-notif aria-hidden="true">
        <span class="chip-ic"><Icon name="calendar-tick" variant="bold" size={18} /></span>
        <span>
          <span class="chip-t">Nueva reserva por tu link</span>
          <span class="chip-s">Diego Paz · jue 15:00</span>
        </span>
      </div>
      <div class="chip chip-saved is-on" data-saved aria-hidden="true">
        <span style="color:var(--nible-lime)"><Icon name="tick-circle" variant="bold" size={20} /></span>
        <span class="chip-saved-t" data-saved-text>Hoy: 8 citas · Bs 420</span>
      </div>
    </div>

    <div class="dots">
      {DEMO.map((d, i) => (
        <button type="button" class:list={['dot', { 'is-on': i === 0 }]} data-dot={i} aria-label={d.label} aria-pressed={i === 0 ? 'true' : 'false'}></button>
      ))}
    </div>
    <p class="step-label" data-demo-label aria-live="polite">{DEMO[0].label}</p>
  </div>
</section>

<style>
  .hero{padding-top:clamp(48px,7vw,96px);padding-bottom:clamp(40px,6vw,72px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:clamp(48px,6vw,72px);align-items:center}
  .badge{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;background:var(--lime-100);color:var(--navy-900);font-size:12px;font-weight:500;white-space:nowrap}
  h1{margin:22px 0 0;font-family:var(--font-display);font-weight:700;font-size:clamp(38px,6vw,68px);line-height:1.05;letter-spacing:-0.02em;color:var(--navy-900);text-wrap:balance}
  h1 span{color:var(--blue-500)}
  .lead{margin:22px 0 0;max-width:470px;font-size:clamp(16px,1.6vw,19px);line-height:1.6;font-weight:300;color:var(--navy-700);text-wrap:pretty}
  .cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
  .meta{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;margin-top:18px;font-size:13px;color:var(--text-muted)}
  .meta > span{white-space:nowrap}
  .meta strong{font-weight:600;color:var(--navy-900)}
  .sep{width:4px;height:4px;border-radius:999px;background:var(--grey-300)}

  .demo{display:flex;flex-direction:column;align-items:center;gap:24px}
  .stage{position:relative;width:min(100%,460px);height:680px;display:flex;justify-content:center;align-items:center}
  .glow{position:absolute;inset:40px 10px 20px;border-radius:999px;background:radial-gradient(closest-side,var(--blue-100),transparent);opacity:.9}

  .tap{position:absolute;left:0;top:0;width:44px;height:44px;border-radius:999px;background:rgba(62,98,216,.22);border:2px solid rgba(62,98,216,.55);z-index:5;opacity:0}
  .tap.run{animation:nible-tap 3.2s cubic-bezier(.2,.7,.3,1) both}

  .chip{position:absolute;display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:16px;box-shadow:var(--shadow-md);opacity:0;transform:translateY(10px);transition:opacity .4s ease,transform .4s cubic-bezier(.2,.7,.3,1)}
  .chip.is-on{opacity:1;transform:translateY(0)}
  .chip-notif{right:-4px;top:150px;background:#FFFFFF;border:1px solid var(--border-subtle)}
  .chip-ic{width:36px;height:36px;display:grid;place-items:center;border-radius:12px;background:var(--lime-100);color:var(--navy-900)}
  .chip-t{display:block;font-size:13px;font-weight:600;color:var(--navy-900);white-space:nowrap}
  .chip-s{display:block;font-size:12px;color:var(--text-muted);white-space:nowrap}
  .chip-saved{left:-4px;bottom:110px;background:var(--navy-900);color:var(--nible-cream)}
  .chip-saved-t{font-size:13px;font-weight:500;white-space:nowrap}

  .dots{display:flex;align-items:center;gap:14px}
  .dot{width:8px;height:8px;padding:0;border:0;border-radius:999px;background:var(--grey-200);cursor:pointer;transition:width .3s ease,background .3s ease}
  .dot.is-on{width:28px;background:var(--blue-500)}
  .step-label{margin:-10px 0 0;min-height:22px;font-size:14px;font-weight:500;color:var(--navy-700);text-align:center}
</style>
