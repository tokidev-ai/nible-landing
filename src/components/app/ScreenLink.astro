---
import Device from './Device.astro';
import Icon from '../ui/Icon.astro';

const card = 'padding:16px;border:1px solid #E1E4ED;border-radius:18px;background:#FFFFFF';
---
<Device>
  <div style="padding:8px 24px 28px">
    <div style="display:flex;align-items:center;gap:14px">
      <span style="width:44px;height:44px;display:grid;place-items:center;border:1px solid #E1E4ED;background:#FFFFFF;border-radius:999px;color:#131C47"><Icon name="arrow-left-02" size={20} /></span>
      <span style="font-family:'Comfortaa',sans-serif;font-size:22px;font-weight:600;color:#131C47">Link de reservas</span>
    </div>
    <div style="position:relative;margin-top:20px;padding:26px 20px;border-radius:24px;background:linear-gradient(160deg,#26356E 0%,#131C47 70%);overflow:hidden;text-align:center">
      <span style="display:block;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#93A9ED">Tu página pública</span>
      <span style="display:block;margin:10px 0 0;font-family:'Comfortaa',sans-serif;font-size:16px;font-weight:600;color:#FFFDF5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">nible.bo/barberia-central</span>
      <div style="display:flex;gap:8px;margin-top:18px">
        <span style="flex:1;height:48px;display:grid;place-items:center;border-radius:14px;background:#E7F1A8;color:#131C47;font-size:15px;font-weight:500">Copiar</span>
        <span style="flex:1;height:48px;display:grid;place-items:center;border:1px solid rgba(255,253,245,.28);border-radius:14px;background:rgba(255,253,245,.10);color:#FFFDF5;font-size:15px;font-weight:500">Compartir</span>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px">
      <div style={card}>
        <span style="display:block;font-family:'Comfortaa',sans-serif;font-size:24px;font-weight:600;color:#131C47">18</span>
        <span style="display:block;font-size:12px;color:#7B8299">reservas por el link este mes</span>
      </div>
      <div style={card}>
        <span style="display:block;font-family:'Comfortaa',sans-serif;font-size:24px;font-weight:600;color:#131C47">96%</span>
        <span style="display:block;font-size:12px;color:#7B8299">asistencia confirmada</span>
      </div>
    </div>
    <div style={`display:flex;align-items:center;gap:12px;margin-top:16px;${card}`}>
      <span style="width:40px;height:40px;display:grid;place-items:center;border-radius:12px;background:#F1F4FD;color:#3E62D8"><Icon name="message-text" size={20} /></span>
      <span style="flex:1;font-size:14px;color:#131C47">Poner el link en mi estado de WhatsApp</span>
      <span style="color:#A2A8BE"><Icon name="arrow-right-02" size={18} /></span>
    </div>
  </div>
</Device>
