---
import Icon from '../ui/Icon.astro';

interface Props {
  /** Active business tab, or omit for screens without the bottom bar. */
  tab?: 'bHoy' | 'bAgenda';
}

/** Static 390×844 replica of the Nible Mobile device (business side). Decorative only. */
const { tab } = Astro.props;
const tabs = [
  { key: 'bHoy', label: 'Hoy', icon: 'home-2' },
  { key: 'bAgenda', label: 'Agenda', icon: 'calendar' },
  { key: 'bClientes', label: 'Clientes', icon: 'people' },
  { key: 'bMas', label: 'Mi negocio', icon: 'setting-2' },
];
---
<div class="nm-device">
  <div style="position:relative;z-index:5;flex:0 0 auto;height:52px;display:flex;align-items:flex-end;justify-content:space-between;padding:0 26px 8px;font-size:13px;font-weight:600;color:#131C47;font-family:'Comfortaa',sans-serif">
    <span>9:41</span>
    <span style="position:absolute;left:50%;top:11px;transform:translateX(-50%);width:104px;height:26px;border-radius:999px;background:#131C47"></span>
    <span style="display:flex;gap:5px;align-items:center;font-size:11px;letter-spacing:.06em">LTE ▮</span>
  </div>
  <div style="flex:1 1 auto;overflow:hidden;position:relative">
    <slot />
  </div>
  {tab && (
    <div style="flex:0 0 auto;display:flex;align-items:flex-start;gap:2px;padding:10px 12px 22px;background:rgba(255,253,245,.92);backdrop-filter:blur(14px);border-top:1px solid #E1E4ED">
      {tabs.map((t) => {
        const on = t.key === tab;
        return (
          <span style={`flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;padding:8px 0;color:${on ? '#3E62D8' : '#7B8299'}`}>
            <Icon name={t.icon} variant={on ? 'bold' : 'broken'} size={24} />
            <span style={`font-size:11px;font-weight:${on ? 500 : 400}`}>{t.label}</span>
          </span>
        );
      })}
    </div>
  )}
  <slot name="sheet" />
</div>

<style>
  .nm-device{position:relative;width:390px;height:844px;background:#FFFDF5;border-radius:44px;border:1px solid #E1E4ED;box-shadow:0 18px 44px rgba(19,28,71,.12);overflow:hidden;display:flex;flex-direction:column;font-family:'Poppins',system-ui,sans-serif;line-height:normal;text-align:left;color:#131C47}
  .nm-device :global(*){box-sizing:border-box}
</style>
