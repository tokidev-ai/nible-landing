---
import Device from './Device.astro';
import Icon from '../ui/Icon.astro';
import { SERVICES } from './data';

interface Props {
  /** 1 = business details, 2 = services, 4 = done (step 3, hours, is not shown on the landing). */
  paso: 1 | 2 | 4;
}

const { paso } = Astro.props;
const cta = { 1: 'Continuar', 2: 'Continuar', 4: 'Ir a mi agenda' }[paso];
const rubros = [
  { name: 'Barbería', icon: 'scissor' }, { name: 'Estética', icon: 'magic-star' }, { name: 'Salud', icon: 'shield-tick' },
  { name: 'Uñas', icon: 'heart' }, { name: 'Otro', icon: 'shop' },
];
const label = 'display:block;font-size:13px;font-weight:500;color:#3E4463';
const field = 'display:flex;align-items:center;width:100%;height:56px;border:1.5px solid #E1E4ED;border-radius:14px;background:#FFFFFF;padding:0 16px;font-size:16px;color:#131C47';
const title = "display:block;font-family:'Comfortaa',sans-serif;font-weight:600;font-size:26px;color:#131C47";
---
<Device>
  <div style="padding:8px 24px 34px">
    <div style="display:flex;align-items:center;gap:14px">
      <span style="width:44px;height:44px;display:grid;place-items:center;border:1px solid #E1E4ED;background:#FFFFFF;border-radius:999px;color:#131C47"><Icon name="arrow-left-02" size={20} /></span>
      <div style="flex:1;height:6px;border-radius:999px;background:#E1E4ED;overflow:hidden">
        <div style={`height:100%;width:${paso * 25}%;background:#3E62D8;border-radius:999px`}></div>
      </div>
      <span style="font-size:12px;color:#7B8299">{Math.min(paso, 3)} de 3</span>
    </div>

    {paso === 1 && (
      <div>
        <span style={`${title};margin:28px 0 8px`}>Cuéntanos de tu negocio</span>
        <span style="display:block;margin:0 0 24px;font-size:14px;color:#7B8299">Solo lo básico. Puedes cambiarlo después.</span>
        <span style={`${label};margin-bottom:8px`}>Nombre del negocio</span>
        <span style={field}>Barbería Central</span>
        <span style={`${label};margin:20px 0 10px`}>Rubro</span>
        <div style="display:flex;flex-wrap:wrap;gap:8px">
          {rubros.map((r) => {
            const on = r.name === 'Barbería';
            return (
              <span style={`display:flex;align-items:center;gap:8px;height:44px;padding:0 16px;border:1.5px solid ${on ? '#131C47' : '#E1E4ED'};border-radius:999px;background:${on ? '#131C47' : '#FFFFFF'};color:${on ? '#FFFDF5' : '#3E4463'};font-size:14px;font-weight:500`}>
                <Icon name={r.icon} variant={on ? 'bold' : 'broken'} size={18} />
                {r.name}
              </span>
            );
          })}
        </div>
        <span style={`${label};margin:20px 0 8px`}>Zona</span>
        <span style={field}>Equipetrol · Calle 5</span>
      </div>
    )}

    {paso === 2 && (
      <div>
        <span style={`${title};margin:28px 0 8px`}>¿Qué servicios ofreces?</span>
        <span style="display:block;margin:0 0 20px;font-size:14px;color:#7B8299">Marca los que ya tienes. Después agregas más.</span>
        <div style="display:flex;flex-direction:column;gap:10px">
          {SERVICES.map((s) => (
            <span style="display:flex;align-items:center;gap:14px;width:100%;padding:16px;border:1.5px solid #3E62D8;border-radius:20px;background:#FFFFFF">
              <span style="width:44px;height:44px;flex:0 0 auto;display:grid;place-items:center;border-radius:14px;background:#E4EAFB;color:#3E62D8"><Icon name={s.icon} variant="bold" size={22} /></span>
              <span style="flex:1">
                <span style="display:block;font-size:15px;font-weight:500;color:#131C47">{s.name}</span>
                <span style="display:block;font-size:13px;color:#7B8299">{s.dur} · Bs {s.price}</span>
              </span>
              <span style="color:#3E62D8"><Icon name="tick-circle" variant="bold" size={24} /></span>
            </span>
          ))}
        </div>
        <span style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;height:52px;margin-top:12px;border:1.5px dashed #C9CDDB;border-radius:14px;color:#3E62D8;font-size:15px;font-weight:500">
          <Icon name="add" size={20} />
          Agregar otro servicio
        </span>
      </div>
    )}

    {paso === 4 && (
      <div style="text-align:center;padding-top:40px">
        <span style="display:inline-grid;place-items:center;width:88px;height:88px;border-radius:999px;background:#E7F1A8;color:#131C47"><Icon name="tick-circle" variant="bold" size={44} /></span>
        <span style={`${title};margin:24px 0 8px`}>Tu negocio está listo</span>
        <span style="display:block;margin:0 0 24px;font-size:14px;color:#7B8299">Comparte tu link y empieza a recibir reservas.</span>
        <div style="display:flex;align-items:center;gap:10px;padding:16px;border:1px solid #E1E4ED;border-radius:20px;background:#FFFFFF;text-align:left">
          <span style="width:40px;height:40px;display:grid;place-items:center;border-radius:12px;background:#E4EAFB;color:#3E62D8"><Icon name="global" size={20} /></span>
          <span style="flex:1;min-width:0;font-size:13px;font-weight:500;color:#131C47;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">nible.bo/barberia-central</span>
          <span style="height:40px;display:flex;align-items:center;padding:0 14px;border-radius:12px;background:#E4EAFB;color:#25409C;font-size:13px;font-weight:500">Copiar</span>
        </div>
      </div>
    )}

    <span style="display:grid;place-items:center;width:100%;height:56px;margin-top:28px;border-radius:14px;background:#3E62D8;color:#FFFDF5;font-size:16px;font-weight:500;box-shadow:0 10px 24px rgba(19,28,71,.24)">{cta}</span>
  </div>
</Device>
